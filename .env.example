# =====================================================================
# KONFIGURASI ENVIRONMENT PHP - RSKD DUREN SAWIT
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi lokal Anda
# =====================================================================

APP_ENV=local

# Konfigurasi Database SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=form_pfe
DB_TRUST_SERVER_CERTIFICATE=true

# Aturan Pengiriman Notifikasi WhatsApp
# WA_NOTIFICATION_LEAD_DAYS=1 berarti dikirim H-1 sebelum tanggal FPE
WA_NOTIFICATION_LEAD_DAYS=1
WA_NOTIFICATION_TIME=09:00

# Mode Pengujian (Aktifkan untuk menampilkan tombol tes WhatsApp di UI)
WA_TEST_MODE=true
WA_TEST_PHONE=6285159811407
