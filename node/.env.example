# =====================================================================
# KONFIGURASI ENVIRONMENT NODE.JS WORKER - RSKD DUREN SAWIT
# =====================================================================

# Database SQL Server
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=form_pfe
DB_TRUST_SERVER_CERTIFICATE=true

# Provider WhatsApp: 'baileys' (untuk dev/pengujian lokal) atau 'cloud_api' (untuk produksi)
WHATSAPP_PROVIDER=baileys

# Konfigurasi Polling & Antrean
QUEUE_POLL_INTERVAL_MS=15000
QUEUE_PROCESSING_TIMEOUT_MINUTES=10
WA_MAX_ATTEMPTS=3

# HTTP Health Check Port
HEALTH_PORT=3001
TZ=Asia/Jakarta

# Konfigurasi Khusus WhatsApp Cloud API (Hanya diisi jika WHATSAPP_PROVIDER=cloud_api)
WA_CLOUD_API_BASE_URL=https://graph.facebook.com
WA_CLOUD_API_VERSION=v19.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
